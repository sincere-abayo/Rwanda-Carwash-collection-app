# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# curl -X POST https://collection.cyesha.com/api/admin/reset-data
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: PostgreSQL database URL on Supabase
SUPABASE_URL="https://hwurrsoukorftvrmcwwj.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Supabase secret service role key (bypasses RLS for secure server operations)
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY: Supabase public anonymous key (optional)
SUPABASE_ANON_KEY=""

# Direct PostgreSQL Engine Connection Variables
PGHOST="db.hwurrsoukorftvrmcwwj.supabase.co"
PGPORT="5432"
PGUSER="postgres"
PGDATABASE="postgres"
PGPASSWORD=""
DATABASE_URL=""
